+// BlueMagpie 的官方 Sequence：精確 Unicode Split，再逐片套用 ByteLevel regex。
+// 使用同一 HF regex 引擎產生的分類表，避免將 Lu/Ll/Lt 近似為 ASCII 大小寫。
+static std::vector<size_t> unicode_regex_split_bluemagpie(const std::string & text, const std::vector<size_t> & offsets) {
+    const auto cpts = unicode_cpts_from_utf8(text);
+    std::string first(cpts.size(), '?');
+    std::string second(cpts.size(), '?');
+    const auto * begin = bluemagpie_unicode_ranges;
+    const auto * end = begin + sizeof(bluemagpie_unicode_ranges) / sizeof(*begin);
+    for (size_t i = 0; i < cpts.size(); ++i) {
+        const auto cp = cpts[i];
+        const auto * range = std::upper_bound(begin, end, cp,
+            [](uint32_t value, const bluemagpie_unicode_range & item) { return value < item.start; });
+        const char category = (range - 1)->category;
+        first[i] = category;
+        if (cp < 128) {
+            second[i] = static_cast<char>(cp);
+        } else if (category == 'U' || category == 'T' || category == 'l' || category == 'm' || category == 'o') {
+            second[i] = '\x01';
+        } else if (category == '0') {
+            second[i] = '\x02';
+        } else if (category == '\v') {
+            second[i] = '\v';
+        }
+    }
+    const std::string split = R"([^\r\nUTlmo0]?[UTmoM]*[lmoM]+|[^\r\nUTlmo0]?[UTmoM]+[lmoM]*|0| ?[^\sUTlmo0]+[\r\n/]*|\s*[\r\n]+|\s+(?!\S)|\s+)";
+    const auto isolated = unicode_regex_split_stl(first, split, offsets);
+    const std::string bytelevel = R"('s|'t|'re|'ve|'m|'ll|'d| ?[A-Za-z\x01]+| ?[0-9\x02]+| ?[^\sA-Za-z0-9\x01\x02]+|\s+(?!\S)|\s+)";
+    return unicode_regex_split_stl(second, bytelevel, isolated);
+}

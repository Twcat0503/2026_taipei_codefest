# 這台主機上的 OpenAI-compatible 解析模型（以 /v1 結尾）
PARSER_MODEL_ENDPOINT=
PARSER_MODEL_NAME=
# 留空使用 Playwright Chromium；已安裝的 Edge 可設 msedge
PARSER_BROWSER_CHANNEL=
# 預設 127.0.0.1:7331；手機連線時設為主機的 LAN 位址或 0.0.0.0
TOOL_REGISTRY_HOST=
TOOL_REGISTRY_PORT=
# 預設 tools/townpass/data/services.json
TOOL_REGISTRY_FILE=
# 允許跨來源呼叫工具庫的網頁來源，以逗號分隔，例如 http://127.0.0.1:5173；預設不允許
TOOL_REGISTRY_ALLOWED_ORIGINS=

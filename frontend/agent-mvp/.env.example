# Leave endpoint empty for deterministic demo mode. No secrets in VITE_* variables.
VITE_MODEL_ENDPOINT=
VITE_MODEL_NAME=
# json-schema for the tested Ollama adapter; tools for native tool calls.
VITE_MODEL_PROTOCOL=
# townpass reads the Town Pass demo site through tools/townpass; empty uses fictional fixtures.
VITE_TOOL_SOURCE=

# Leave endpoint empty for deterministic demo mode. No secrets in VITE_* variables.
VITE_MODEL_ENDPOINT=
VITE_MODEL_NAME=
# json-schema for the tested Ollama adapter; tools for native tool calls.
VITE_MODEL_PROTOCOL=
# Empty (default): only real data and official destinations via tools/townpass.
# townpass-demo: also the demo-site tools and demo bills (development only).
# demo: fully fictional fixtures for UI tests.
VITE_TOOL_SOURCE=
